# Local admin/credential scratch — these hold the VPS password and the founder
# password. They live on the workstation only and must never be published.
# Anchored with "/" on purpose: an unanchored login*.js would also swallow the
# cockpit's own command-center/lib/login-page.js.
/login.js
/login2.js
/login3.js
/login4.js
/login5.js
/login-debug.js
/login-direct.js
/login-final.js
/signin_admin.mjs
