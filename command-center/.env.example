# NOEDIS Command Center — configuration
# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Server
NOEDIS_PORT=3200
NOEDIS_HOST=127.0.0.1

# Paperclip
# Local development against a tunnelled VPS instance:
#   ssh -N -L 127.0.0.1:13100:127.0.0.1:3100 -p 501 vpsadmin@76.13.154.124
PAPERCLIP_URL=http://127.0.0.1:3100
# Board API key — server-side only, never exposed to the browser.
PAPERCLIP_API_KEY=
NOEDIS_COMPANY_ID=8b5aa752-5199-4f51-9a9c-817647ef1aae

# Native Paperclip UI to embed in the PAPERCLIP tab
NOEDIS_PAPERCLIP_UI_URL=https://www.noedis.org

# Live polling interval (ms); the WebSocket pushes deltas between polls
NOEDIS_POLL_MS=4000

# Log verbosity: info | silent
NOEDIS_LOG_LEVEL=info

# ── Cockpit sign-in ────────────────────────────────────────────
# One operator, one signed cookie. While no password of either form is
# set the gate stays OPEN, so a half-configured deploy can never lock the
# founder out of the box — check the boot log line `Auth : ON|OFF`.
NOEDIS_AUTH_USER=noedis
# Plaintext, compared in constant time. Preferred: this file is git-ignored.
NOEDIS_AUTH_PASS=
# Or a scrypt hash — `node -e "import('./lib/auth.js').then(m=>console.log(m.hashPassword(process.argv[1])))" 'the-password'`
NOEDIS_AUTH_PASS_HASH=
# Cookie signing key. Without it a restart signs every session out.
NOEDIS_SESSION_SECRET=
# Session lifetime in hours (default 12).
NOEDIS_SESSION_HOURS=12
